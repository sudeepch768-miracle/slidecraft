# =============================================================================
# SlideCraft AI — .gitignore
# =============================================================================

# ---- Dependencies -----------------------------------------------------------
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ---- Next.js ----------------------------------------------------------------
/.next/
/out/
/build

# ---- Production -------------------------------------------------------------
/dist
/dist-test/

# ---- Environment variables (NEVER commit secrets) ---------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- Testing & Coverage -----------------------------------------------------
/coverage
/playwright-report
/test-results

# ---- Output & Temporary Files -----------------------------------------------
/output/
/tmp_test_output/
/artifacts/
/scratch/

# ---- TypeScript -------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# ---- Debug Logs -------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- OS & Editor Artifacts --------------------------------------------------
.DS_Store
Thumbs.db
*.pem

# ---- Vercel -----------------------------------------------------------------
.vercel

# ---- IDE -------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---- Misc -------------------------------------------------------------------
*.tgz
.cache/

# ---- Local Documentation ----------------------------------------------------
*.docx
SlideCraft_AI_Project_Documentation.docx
/scripts/doc_content/
/scripts/generate_sits_documentation.js

