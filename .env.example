# =============================================================================
# SlideCraft AI - Environment Variables
# =============================================================================

# 1. Supabase Backend Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. Text & Fast Content Provider: Groq (Primary Text Inference)
# Obtain from https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Implementation & Technical Fallback Provider: OpenRouter (Strict Free-Tier Only)
# Obtain from https://openrouter.ai/keys
# ONLY free models permitted: openrouter/free or models with ':free' suffix
# Paid models and openrouter/auto are strictly blocked by SlideCraft AI
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_TEXT_MODEL=openrouter/free

# 4. Dedicated Image & Visual Design Provider: NVIDIA FLUX (Server-Side Only)
# Obtain your API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_API_BASE_URL=https://ai.api.nvidia.com/v1/genai
# Models: black-forest-labs/flux.2-klein-4b, black-forest-labs/flux.1-schnell
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# 5. Complex Reasoning, QA Review & Orchestration Provider: Google Gemini
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# 6. Multi-Provider Routing Mode
# "multi" (Central Task Router distributing workloads across Groq, NVIDIA, OpenRouter, Gemini)
AI_PROVIDER_ROUTING=multi
AI_PROVIDER=chain

# 7. Rate Limiting (Optional - Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 8. Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
